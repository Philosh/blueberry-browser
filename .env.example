OPENAI_API_KEY=

# Remote code execution (optional). Full URL including path, e.g. http://IP:3000/execute
# Leave unset to use local Docker for Code Interpreter.
CODE_EXEC_API_URL=
# Only if server has BLUEBERRY_API_KEY set
CODE_EXEC_API_KEY=
CODE_EXEC_TIMEOUT_MS=30000
# Retries on 503/429 when using remote executor (defaults: 3 attempts, 500ms base backoff)
# CODE_EXEC_MAX_ATTEMPTS=3
# CODE_EXEC_RETRY_BASE_MS=500