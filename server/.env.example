# Blueberry exec server — copy to .env and adjust. See server/README.md for details.

PORT=3000
HOST=0.0.0.0

# Optional. If set, clients must send Authorization: Bearer <same value>
BLUEBERRY_API_KEY=

# Capacity: reject with 503 when this many Firecracker VMs are running at once
MAX_CONCURRENT_VMS=15

# Extra host time (ms) beyond payload timeout before SIGKILL
VM_HOST_OVERHEAD_MS=25000

# @fastify/rate-limit: max requests per client IP per window; set to 0 to disable
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Behind HTTP(S) load balancer: set to 1 so X-Forwarded-For drives request.ip (rate limits per real client)
# TRUST_PROXY=1

# Override Firecracker assets dir if not under /opt/firecracker
# FIRECRACKER_DIR=/opt/firecracker

# Verbose VM logs (optional)
# EXEC_VM_DEBUG=1
# EXEC_VM_VERBOSE=1
